{
  "id": "gladia",
  "name": "Gladia",
  "description": "Gladia batch speech-to-text provider for OpenClaw media understanding",
  "providers": [
    "gladia"
  ],
  "contracts": {
    "mediaUnderstandingProviders": [
      "gladia"
    ]
  },
  "mediaUnderstandingProviderMetadata": {
    "gladia": {
      "capabilities": [
        "audio"
      ],
      "defaultModels": {
        "audio": "solaria-1"
      },
      "autoPriority": {
        "audio": 45
      }
    }
  },
  "modelSupport": {
