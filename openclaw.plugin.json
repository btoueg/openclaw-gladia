          "GLADIA_API_KEY"
        ]
      }
    ]
  },
  "providerAuthEnvVars": {
    "gladia": [
      "GLADIA_API_KEY"
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "gladia",
      "method": "api-key",
      "choiceId": "gladia-api-key",
      "choiceLabel": "Gladia API key",
      "groupId": "gladia",
      "groupLabel": "Gladia",
      "cliFlag": "--gladia-api-key",
      "cliOption": "--gladia-api-key <key>",
      "cliDescription": "Gladia API key"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  }
}
